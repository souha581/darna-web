# Copiez ce fichier vers .env pour le developpement local (ne jamais commiter .env)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Base de donnees PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=darna_dev
DB_USER=darna
DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD

# Comptes de demonstration initiaux (optionnel en dev)
APP_SEED_ENABLED=true
APP_OWNER_USERNAME=owner
APP_OWNER_PASSWORD=CHANGE_ME_OWNER_PASSWORD
APP_RESIDENT_USERNAME=resident
APP_RESIDENT_PASSWORD=CHANGE_ME_RESIDENT_PASSWORD
APP_OUVRIER_USERNAME=ouvrier
APP_OUVRIER_PASSWORD=CHANGE_ME_OUVRIER_PASSWORD
